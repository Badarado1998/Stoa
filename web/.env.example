# Elysium
NEXT_PUBLIC_CHAIN_ID=99901
# one or more, comma-separated (first = primary, rest = fallback)
NEXT_PUBLIC_RPC_URL=https://elysium-mainnet.g.alchemy.com/v2/<key>,https://lb.drpc.live/elysium/<key>
NEXT_PUBLIC_EXPLORER_URL=https://<elysium-explorer>

# Stoa contracts (leave empty until deployed: the app then shows "not deployed yet")
NEXT_PUBLIC_ROUTER=
NEXT_PUBLIC_POOL_WHYPE_USDC=
NEXT_PUBLIC_FEE_DISTRIBUTOR=

# WalletConnect (Reown) project id, optional: without it only browser wallets are offered
NEXT_PUBLIC_WC_PROJECT_ID=

# Shown in the footer once the token is live (leave empty before)
NEXT_PUBLIC_CA=

NEXT_PUBLIC_SITE_URL=https://stoa.trade
